@using System.Collections.Concurrent
@using _20strike_ui.Data.ComputersV2
@implements IDisposable
@inject ComputersV2Client Client

<div class="cv2-problems" role="region" aria-label="Проблемы">
    <div class="cv2-problems-header">
        <span class="oi oi-warning" aria-hidden="true"></span>
        <strong>Проблемы</strong>
        <span class="cv2-problems-status" role="status" aria-live="polite">@StatusText</span>
        <button type="button"
                class="btn btn-sm @(_scanning ? "btn-secondary" : "btn-primary")"
                @onclick="ScanAsync"
                disabled="@(_scanning || Computers.Count == 0)">
            @(_scanning ? "Сканирование..." : "Сканировать")
        </button>
        @if (_scanning)
        {
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="CancelScan">Отмена</button>
        }
    </div>

    @if (_scanning)
    {
        <div class="progress" style="height: 20px;">
            <div class="progress-bar" role="progressbar" style="width: @Percent%" aria-valuenow="@_done" aria-valuemin="0" aria-valuemax="@_total">
                @_done / @_total
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_scanCancelled)
    {
        <div class="alert alert-info" role="status">Сканирование отменено. Показаны частичные результаты.</div>
    }

    @if (_results.Count > 0)
    {
        <div class="cv2-problems-results">
            @foreach (var group in GroupedResults)
            {
                <div class="cv2-problem-group">
                    <div class="cv2-problem-title">
                        <span class="oi oi-warning" aria-hidden="true"></span>
                        @group.Key — @group.First().Problem.Description
                        <span class="badge badge-warning">@group.Count()</span>
                    </div>
                    <ul class="cv2-problem-computers">
                        @foreach (var item in group)
                        {
                            <li>@item.ComputerName</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else if (_scanned && !_scanning && _error is null && !_scanCancelled)
    {
        <div class="alert alert-success" role="status">Проблем не обнаружено.</div>
    }
</div>

@code {
    private const int Concurrency = 8;

    [Parameter] public IReadOnlyList<ComputerSummary> Computers { get; set; } = Array.Empty<ComputerSummary>();

    private bool _scanning;
    private bool _scanned;
    private bool _scanCancelled;
    private string? _error;
    private int _done;
    private int _total;
    private List<ComputerProblem> _results = new();
    private CancellationTokenSource? _scanCts;

    private int Percent => _total == 0 ? 0 : (int)((double)_done / _total * 100);

    private int AffectedComputers => _results.Select(r => r.ComputerName).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private string StatusText => _scanning
        ? $"Сканирование... {_done} из {_total}"
        : _scanned
            ? $"Обнаружено: {_results.Count} у {AffectedComputers} машин"
            : "Запустите сканирование, чтобы найти проблемы.";

    private IEnumerable<IGrouping<string, ComputerProblem>> GroupedResults =>
        _results
            .GroupBy(r => r.Problem.Name, StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    private async Task ScanAsync()
    {
        if (_scanning)
        {
            return;
        }

        var computers = Computers;
        if (computers.Count == 0)
        {
            _error = "Список компьютеров пуст.";
            return;
        }

        _scanCts = new CancellationTokenSource();
        _scanning = true;
        _scanned = true;
        _scanCancelled = false;
        _error = null;
        _done = 0;
        _total = computers.Count;

        var bag = new ConcurrentBag<ComputerProblem>();
        int errors = 0;
        using var semaphore = new SemaphoreSlim(Concurrency);

        try
        {
            var tasks = computers.Select(async computer =>
            {
                await semaphore.WaitAsync(_scanCts.Token).ConfigureAwait(false);
                try
                {
                    var problems = await Client.GetProblemsAsync(computer.Name, _scanCts.Token).ConfigureAwait(false);
                    foreach (var problem in problems)
                    {
                        bag.Add(new ComputerProblem(computer.Name, problem));
                    }
                }
                catch (OperationCanceledException) when (_scanCts.IsCancellationRequested)
                {
                    throw;
                }
                catch
                {
                    Interlocked.Increment(ref errors);
                }
                finally
                {
                    semaphore.Release();
                }

                var done = Interlocked.Increment(ref _done);
                if (done % 10 == 0)
                {
                    await InvokeAsync(StateHasChanged).ConfigureAwait(false);
                }
            }).ToArray();

            await Task.WhenAll(tasks).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (_scanCts.IsCancellationRequested)
        {
            _scanCancelled = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _scanning = false;
            _results = bag
                .OrderBy(r => r.ComputerName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.Problem.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (errors > 0)
            {
                var suffix = $"Не удалось опросить {errors} комп.";
                _error = _error is null ? suffix : $"{_error} {suffix}";
            }

            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                // Renderer no longer available (component disposed).
            }

            _scanCts?.Dispose();
            _scanCts = null;
        }
    }

    private void CancelScan() => _scanCts?.Cancel();

    public void Dispose()
    {
        try
        {
            _scanCts?.Cancel();
        }
        catch
        {
            // Ignore disposal races.
        }
    }
}