@using _20strike_ui.Data.ComputersV2
@using _20strike_ui.Formatting
@inject IComputersV2Client Client
@inject ComputersV2Cache Cache
@inject NavigationManager Nav

<div class="cv2-card" id="@CardId" role="region" aria-labelledby="@RowButtonId" tabindex="-1" @ref="_cardRef"
     @onkeydown="OnCardKeyDown">

    @if (_problems is { Count: > 0 })
    {
        <div class="alert alert-warning cv2-card-problems" role="alert">
            <strong><span class="oi oi-warning" aria-hidden="true"></span> Проблемы</strong>
            <ul>
                @foreach (var problem in _problems)
                {
                    <li>@problem.Name — @problem.Description</li>
                }
            </ul>
        </div>
    }
    else if (_problemsError is not null)
    {
        <div class="alert alert-warning cv2-card-problems" role="alert">
            Не удалось загрузить проблемы: @_problemsError
            <button type="button" class="btn btn-sm btn-primary" @onclick="ReloadProblemsAsync">Повторить</button>
        </div>
    }

    @if (_detailLoading)
    {
        <div role="status" aria-live="polite" aria-busy="true">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Загрузка данных...
        </div>
    }
    else if (_detailError is not null)
    {
        <div class="alert alert-danger" role="alert">
            @_detailError
            <button type="button" class="btn btn-sm btn-primary" @onclick="RetryLoadAsync">Повторить</button>
        </div>
    }
    else if (_detail is not null)
    {
        <div class="cv2-summary">
            <h4 class="cv2-summary-title">@_summary!.Name @StatusEmoji</h4>
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <td>Домен</td>
                        <td class="text-break">@_summary.Domain</td>
                    </tr>
                    <tr>
                        <td>Пользователь</td>
                        <td class="text-break">
                            @DisplayUserName
                            @if (_usersFailed)
                            {
                                <span class="cv2-users-failed">Не удалось загрузить имена пользователей.
                                    <button type="button" class="btn btn-link btn-sm p-0 cv2-users-retry"
                                            @onclick="ReloadUsersAsync">Повторить</button>
                                </span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>Изготовитель</td>
                        <td class="text-break">@_summary.Manufacturer</td>
                    </tr>
                    <tr>
                        <td>ОС</td>
                        <td class="text-break">@_summary.OsName (@_summary.OsVersion)</td>
                    </tr>
                    <tr>
                        <td>Сборка / Архитектура</td>
                        <td class="text-break">@_summary.OsBuild / @_summary.OsArchitecture</td>
                    </tr>
                    <tr>
                        <td>Процессор</td>
                        <td class="text-break">@_summary.Cpu</td>
                    </tr>
                    <tr>
                        <td>Память</td>
                        <td>@_summary.RamTotal</td>
                    </tr>
                    <tr>
                        <td>Диск C: свободно</td>
                        <td>@_summary.DiskCFree</td>
                    </tr>
                    <tr>
                        <td>Последняя загрузка</td>
                        <td>@_summary.LastBootUpTime</td>
                    </tr>
                    <tr>
                        <td>Локальное время</td>
                        <td>@_summary.LocalTime</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="tabs cv2-tabs" role="tablist" aria-label="Подробная информация">
            @for (var i = 0; i < _tabs.Count; i++)
            {
                var tab = _tabs[i];
                var idx = i;
                <span class="tab @(idx == _activeTab ? "tab-active" : "")" role="tab" id="@TabId(tab)"
                      aria-selected="@(idx == _activeTab)" aria-controls="@PanelId(tab)" tabindex="@(idx == _activeTab ? 0 : -1)"
                      @ref="_tabRefs[idx]" @onclick="() => ActivateTab(idx)"
                      @onkeydown="(e) => OnTabKeyDown(e, idx)">@tab.Title</span>
            }
        </div>

        <div class="cv2-tabpanel" id="@PanelId(ActiveTab)" role="tabpanel" aria-labelledby="@TabId(ActiveTab)" tabindex="0">
            @if (ActiveTab.Large is { } large)
            {
                <LargeTab Title="@large.Title" Rows="@large.Rows" Columns="@large.Columns" />
            }
            else if (_sections.TryGetValue(ActiveTab.Id, out var sections))
            {
                @foreach (var section in sections)
                {
                    <h4>@section.Title</h4>
                    <table class="table table-bordered">
                        @if (section.Rows.Count == 0)
                        {
                            <tbody>
                                @foreach (var field in section.Fields)
                                {
                                    <tr>
                                        <td>@field.Key</td>
                                        <td class="text-break">@field.Value</td>
                                    </tr>
                                }
                            </tbody>
                        }
                        else
                        {
                            <thead>
                                <tr>
                                    @foreach (var header in section.Headers)
                                    {
                                        <th>@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in section.Rows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td class="text-break">@cell</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public ComputerSummary Computer { get; set; } = null!;
    [Parameter] public PingInfo? Ping { get; set; }
    [Parameter] public string CardId { get; set; } = "";
    [Parameter] public string RowButtonId { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private ComputerDetail? _detail;
    private DetailSummary? _summary;
    private string? _detailError;
    private bool _detailLoading;
    private List<DetailTab> _tabs = new();
    private IReadOnlyDictionary<string, IReadOnlyList<SectionView>> _sections = new Dictionary<string,
IReadOnlyList<SectionView>>();
    private int _activeTab;
    private ElementReference[] _tabRefs = Array.Empty<ElementReference>();
    private ElementReference _cardRef;
    private bool _cardFocused;

    private List<ProblemInfo>? _problems;
    private string? _problemsError;

    // Users map (GET /v2/users) is fetched once per circuit by ComputersV2Cache; while it loads or
    // after a failure the summary row simply shows the raw UserName.
    private IReadOnlyDictionary<string, string> _usersByLogin = new Dictionary<string,
string>(StringComparer.OrdinalIgnoreCase);
    private bool _usersFailed;

    private DetailTab ActiveTab => _tabs[_activeTab];

    private string StatusEmoji => Ping is null ? "" : (Ping.Status ? "🟢" : "🔴");

    // "Full Name (UserName)" when the login resolves, otherwise the raw UserName ("—" included).
    private string DisplayUserName =>
        _summary is null ? "" : ValueFormatters.FormatUserName(_summary.UserName, _usersByLogin);

    private void OpenOnMap() =>
        Nav.NavigateTo($"/v2/map/{Uri.EscapeDataString(Computer.Name)}");

    protected override void OnInitialized()
    {
        _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        await Task.WhenAll(LoadDetailAsync(), LoadProblemsAsync(), LoadUsersAsync());
        await TryRefreshAsync();
    }

    private async Task LoadDetailAsync()
    {
        _detailLoading = true;
        try
        {
            var result = await Cache.GetOrLoadDetailAsync(Computer.Name, ct => Client.GetComputerByNameAsync(Computer.Name, ct));
            if (result.Detail is null)
            {
                _detailError = result.ErrorMessage ?? "Не удалось загрузить данные.";
                return;
            }

            _detail = result.Detail;
            _summary = ComputerDetailViewFactory.BuildSummary(_detail);
            BuildTabs(_detail);
        }
        catch (OperationCanceledException)
        {
            // Component removed while loading; ignore.
        }
        finally
        {
            _detailLoading = false;
        }
    }

    private async Task LoadProblemsAsync()
    {
        _problemsError = null;
        try
        {
            _problems = (await Cache.GetOrLoadProblemsAsync(Computer.Name, ct => Client.GetProblemsAsync(Computer.Name,
ct))).ToList();
        }
        catch (OperationCanceledException)
        {
            // Component removed while loading; ignore.
        }
        catch (Exception ex)
        {
            _problemsError = ex.Message;
        }
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var result = await Cache.GetOrLoadUsersAsync(ct => Client.GetUsersAsync(ct));
            _usersByLogin = result.UsersByLogin;
            _usersFailed = result.ErrorMessage is not null;
        }
        catch (OperationCanceledException)
        {
            // Component removed while loading; ignore.
        }
    }

    private async Task ReloadUsersAsync()
    {
        Cache.InvalidateUsers();
        await LoadUsersAsync();
        await TryRefreshAsync();
    }

    private async Task RetryLoadAsync()
    {
        Cache.InvalidateDetail(Computer.Name);
        await LoadDetailAsync();
        await TryRefreshAsync();
    }

    private async Task ReloadProblemsAsync()
    {
        Cache.InvalidateProblems(Computer.Name);
        await LoadProblemsAsync();
        await TryRefreshAsync();
    }

    private async Task TryRefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Renderer no longer available (component disposed).
        }
    }

    private void BuildTabs(ComputerDetail detail)
    {
        var tabs = ComputerDetailViewFactory.BuildTabs(detail);
        _tabs = tabs.Tabs.ToList();
        _tabRefs = new ElementReference[_tabs.Count];
        _sections = tabs.Sections;
        _activeTab = 0;
    }

    private void ActivateTab(int index)
    {
        if (index < 0 || index >= _tabs.Count || index == _activeTab)
        {
            return;
        }

        _activeTab = index;
    }

    private async Task OnTabKeyDown(KeyboardEventArgs e, int index)
    {
        int next = -1;
        switch (e.Key)
        {
            case "ArrowRight": next = (index + 1) % _tabs.Count; break;
            case "ArrowLeft": next = (index - 1 + _tabs.Count) % _tabs.Count; break;
            case "Home": next = 0; break;
            case "End": next = _tabs.Count - 1; break;
            case "Enter":
            case " ":
                ActivateTab(index);
                return;
        }

        if (next >= 0)
        {
            ActivateTab(next);
            try
            {
                await _tabRefs[next].FocusAsync();
            }
            catch
            {
                // Tab element not rendered; activation still applies.
            }
        }
    }

    private async Task OnCardKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    private string TabId(DetailTab tab) => $"{CardId}-tab-{tab.Id}";
    private string PanelId(DetailTab tab) => $"{CardId}-panel-{tab.Id}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the card once when it opens so keyboard users land in the content.
        if (!_cardFocused)
        {
            _cardFocused = true;
            try
            {
                await _cardRef.FocusAsync();
            }
            catch
            {
                // Focus target no longer available; ignore.
            }
        }
    }
}