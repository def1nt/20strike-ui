@page "/v2/computers"
@using _20strike_ui.Data.ComputersV2
@implements IDisposable
@inject ComputersV2Client Client
@inject IJSRuntime JS

<PageTitle>Computers v2</PageTitle>

<h3>Computers v2</h3>

<div class="cv2-toolbar">
    <div class="cv2-filter-wrap">
        <input class="form-control cv2-filter" @bind="_nameFilter" @bind:event="oninput" placeholder="Фильтр по имени"
               aria-label="Фильтр по имени компьютера" />
        @if (!string.IsNullOrEmpty(_nameFilter))
        {
            <button type="button" class="cv2-filter-clear" @onclick="ClearNameFilter" aria-label="Очистить фильтр по имени"
                    title="Очистить фильтр">X</button>
        }
    </div>
    <button type="button" class="btn btn-outline-secondary cv2-search-toggle" @onclick="ToggleSearchPanel"
            aria-expanded="@_searchPanelOpen" aria-controls="cv2-search-panel">
        @(_searchPanelOpen ? "Скрыть поиск" : "Расширенный поиск")
    </button>
</div>

@if (_searchPanelOpen)
{
    <div class="cv2-search-panel" id="cv2-search-panel" role="region" aria-label="Поиск по параметрам">
        <div class="cv2-search-row">
            <label class="cv2-search-label" for="cv2-search-type">Параметр:</label>
            <select id="cv2-search-type" class="form-select cv2-search-type" @bind="_searchType">
                <option value="@ComputerSearchType.Username">Имя пользователя</option>
                <option value="@ComputerSearchType.Hardware">Оборудование</option>
                <option value="@ComputerSearchType.Software">Программное обеспечение</option>
                <option value="@ComputerSearchType.Mac">MAC-адрес</option>
            </select>
        </div>
        <form class="cv2-search-row" @onsubmit="RunSearchAsync" @onsubmit:preventDefault="true">
            <label class="cv2-search-label" for="cv2-search-query">Значение:</label>
            <input id="cv2-search-query" class="form-control cv2-search-input" @bind="_searchQuery" @bind:event="oninput"
                   placeholder="@SearchPlaceholder" aria-label="Значение для поиска" autocomplete="off" />
            <button type="submit" class="btn btn-primary"
                    disabled="@(_searchLoading || string.IsNullOrWhiteSpace(_searchQuery))">
                Найти
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ResetSearch">Сбросить</button>
        </form>
    </div>
}

@if (_initialLoading)
{
    <div class="cv2-loading" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Загрузка списка...
        <div class="cv2-skeleton" aria-hidden="true">
            <div class="cv2-skeleton-row"></div>
            <div class="cv2-skeleton-row"></div>
            <div class="cv2-skeleton-row"></div>
            <div class="cv2-skeleton-row"></div>
            <div class="cv2-skeleton-row"></div>
        </div>
    </div>
}
else if (_initialError is not null)
{
    <div class="alert alert-danger" role="alert">
        Не удалось загрузить список компьютеров: @_initialError
        <button type="button" class="btn btn-sm btn-primary" @onclick="ReloadAsync">Повторить</button>
    </div>
}
else
{
    @if (_searchLoading)
    {
        <div class="cv2-loading cv2-search-status" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Поиск...
        </div>
    }
    else if (_searchError is not null)
    {
        <div class="alert alert-danger alert-dismissible cv2-search-status" role="alert">
            <span>Не удалось выполнить поиск: @_searchError</span>
            <button type="button" class="btn btn-sm btn-primary" @onclick="RunSearchAsync">Повторить</button>
            <button type="button" class="btn-close" aria-label="Закрыть" @onclick="DismissSearchError"></button>
        </div>
    }

    @if (!_searchActive && _computers.Count == 0)
    {
        <div class="cv2-empty">Нет данных о компьютерах.</div>
    }
    else if (_searchActive && _searchResults!.Count == 0)
    {
        <div class="cv2-empty">Ничего не найдено.</div>
    }
    else
    {
        @if (_pingFailed)
        {
            <div class="alert alert-warning" role="alert">Не удалось обновить статусы пинга. Показаны последние известные данные.
            </div>
        }

        <ul class="cv2-list" id="myUL">
            @foreach (var computer in FilteredComputers)
            {
                var name = computer.Name;
                var expanded = _expanded.Contains(name);
                <ComputerRow @key="name" Computer="computer" Ping="@GetPing(name)" Expanded="expanded"
                             OnToggle="() => ToggleExpanded(name)" />
            }
        </ul>
        <hr />
        <span>@(_searchActive ? "Найдено" : "Всего"): @FilteredComputers.Count</span>
    }
}

@if (_showScrollTop)
{
    <button type="button" class="cv2-scroll-top" @onclick="ScrollToTopAsync" aria-label="Прокрутить наверх"
            title="Наверх">⬆</button>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private readonly Dictionary<string, PingInfo> _pings = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    // Poll cadence: 30s normally, 5s while the last refresh failed (e.g. backend rate limiting),
    // so the UI recovers automatically within a few seconds of the endpoint coming back.
    private static readonly TimeSpan PingPollInterval = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan PingRetryInterval = TimeSpan.FromSeconds(5);

    private List<ComputerSummary> _computers = new();
    private string _nameFilter = "";
    private bool _initialLoading = true;
    private string? _initialError;
    private bool _pingFailed;

    // Search panel state. A non-null _searchResults means search mode is active: the API response
    // becomes the base for both rendering and the quick filter, replacing the full computer list.
    private bool _searchPanelOpen;
    private ComputerSearchType _searchType = ComputerSearchType.Username;
    private string _searchQuery = "";
    private bool _searchLoading;
    private string? _searchError;
    private List<ComputerSummary>? _searchResults;
    private CancellationTokenSource? _searchCts;

    // Scroll-to-top floating button: tracks the window scroll position via JS interop and
    // becomes visible once the user scrolls down past the threshold.
    private const int ScrollTopThreshold = 200;
    private bool _showScrollTop;
    private DotNetObjectReference<ComputersV2>? _scrollRef;

    private bool _searchActive => _searchResults is not null;

    private string SearchPlaceholder => _searchType switch
    {
        ComputerSearchType.Username => "например, Иванов или ivanov",
        ComputerSearchType.Hardware => "например, Intel Core i5",
        ComputerSearchType.Software => "например, Adobe Photoshop",
        ComputerSearchType.Mac => "например, 00:1A:2B:3C:4D:5E",
        _ => "",
    };

    // The list the quick filter operates on: search results while a search is active,
    // otherwise the full computer list. The quick filter itself is unchanged.
    private IReadOnlyList<ComputerSummary> BaseComputers => _searchResults ?? _computers;

    private IReadOnlyList<ComputerSummary> FilteredComputers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_nameFilter))
            {
                return BaseComputers;
            }

            var query = _nameFilter.Trim();
            return BaseComputers.Where(c => c.Name.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override void OnInitialized()
    {
        // Initialization is deferred to OnAfterRenderAsync(firstRender): with ServerPrerendered
        // the page renders once statically and again when the interactive circuit starts. Starting
        // the load from OnInitialized would fire a second /ping (and /computers) request at the
        // exact moment the first one lands, tripping the backend rate limiter. OnAfterRenderAsync
        // runs only in the interactive circuit, exactly once per navigation.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scrollRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cv2InitScrollTracking", _scrollRef, ScrollTopThreshold);
            _ = LoadInitialAsync();
            _ = PollPingLoopAsync();
        }
    }

    [JSInvokable]
    public void OnWindowScroll(bool scrolledDown)
    {
        if (_showScrollTop != scrolledDown)
        {
            _showScrollTop = scrolledDown;
            StateHasChanged();
        }
    }

    private void ClearNameFilter() => _nameFilter = "";

    private async Task ScrollToTopAsync()
    {
        await JS.InvokeVoidAsync("cv2ScrollToTop");
    }

    private void ToggleSearchPanel() => _searchPanelOpen = !_searchPanelOpen;

    private void DismissSearchError() => _searchError = null;

    private async Task RunSearchAsync()
    {
        var query = _searchQuery.Trim();
        if (query.Length == 0)
        {
            return;
        }

        // Supersede any in-flight search: a stale response must never overwrite a newer one.
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var cts = _searchCts;

        _searchLoading = true;
        _searchError = null;

        IReadOnlyList<ComputerSummary> results;
        try
        {
            results = await Client.SearchComputersAsync(_searchType, query, cts.Token).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            return; // superseded by a newer search or component disposal
        }
        catch (Exception ex)
        {
            // Keep the currently displayed list intact; surface a dismissible error above it.
            await InvokeAsync(() =>
            {
                _searchLoading = false;
                _searchError = ex.Message;
                StateHasChanged();
            });
            return;
        }

        await InvokeAsync(() =>
        {
            if (_searchCts != cts || _cts.IsCancellationRequested)
            {
                return; // a newer search started or the component was disposed
            }

            _searchLoading = false;
            _searchResults = results.ToList();
            StateHasChanged();
        });
    }

    private void ResetSearch()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;

        _searchQuery = "";
        _searchLoading = false;
        _searchError = null;
        _searchResults = null;
        _searchPanelOpen = false;
    }

    private async Task LoadInitialAsync()
    {
        _initialLoading = true;
        _initialError = null;

        // The computer list is the only hard dependency. Transient failures (throttling,
        // restarts) are retried with a short exponential back-off before giving up.
        const int maxAttempts = 3;
        var computers = new List<ComputerSummary>();
        string? lastError = null;
        for (var attempt = 1; attempt <= maxAttempts; attempt++)
        {
            try
            {
                computers = (await Client.GetComputersAsync(_cts.Token).ConfigureAwait(false)).ToList();
                lastError = null;
                break;
            }
            catch (OperationCanceledException) when (_cts.IsCancellationRequested)
            {
                return; // component disposed while loading
            }
            catch (Exception ex) when (attempt < maxAttempts)
            {
                lastError = ex.Message;
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(attempt), _cts.Token).ConfigureAwait(false);
                }
                catch (OperationCanceledException)
                {
                    return;
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        // Ping statuses are best-effort: a throttled /ping must never hide the computer list.
        // The poll loop retries every few seconds until the endpoint recovers.
        IReadOnlyList<PingInfo>? pings = null;
        var pingFailed = false;
        if (!_cts.IsCancellationRequested)
        {
            try
            {
                pings = await Client.GetPingAsync(_cts.Token).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (_cts.IsCancellationRequested)
            {
                return; // component disposed while loading
            }
            catch
            {
                pingFailed = true;
            }
        }

        // Continuations above ran on thread-pool threads because of ConfigureAwait(false); switch
        // back to the Dispatcher before touching component state or rendering.
        await InvokeAsync(() =>
        {
            if (_cts.IsCancellationRequested)
            {
                return;
            }

            _computers = computers;
            _initialError = lastError;
            if (pings is not null)
            {
                ApplyPing(pings);
                _pingFailed = ComputersV2Client.IsPingThrottled;
            }
            else if (pingFailed)
            {
                _pingFailed = true;
            }

            _initialLoading = false;
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        await LoadInitialAsync();
    }

    private void ApplyPing(IEnumerable<PingInfo> pings)
    {
        _pings.Clear();
        foreach (var ping in pings)
        {
            _pings[ping.Name] = ping;
        }
    }

    private PingInfo? GetPing(string name) => _pings.TryGetValue(name, out var ping) ? ping : null;

    private void ToggleExpanded(string name)
    {
        if (!_expanded.Add(name))
        {
            _expanded.Remove(name);
        }
    }

    // Keep the ping indicators fresh: refresh immediately on start, then poll every 30 seconds.
    // While a refresh fails (backend rate limiting) the interval drops to 5 seconds so the UI
    // self-heals without requiring the user to press "Повторить".
    private async Task PollPingLoopAsync()
    {
        try
        {
            while (true)
            {
                await RefreshPingAsync().ConfigureAwait(false);
                await Task.Delay(_pingFailed ? PingRetryInterval : PingPollInterval, _cts.Token).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped on unmount.
        }
    }

    private async Task RefreshPingAsync()
    {
        IReadOnlyList<PingInfo> pings;
        try
        {
            pings = await Client.GetPingAsync(_cts.Token).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            await InvokeAsync(() =>
            {
                _pingFailed = true;
                StateHasChanged();
            });
            return;
        }

        // The client may have served the last known payload while the endpoint is throttled;
        // keep the warning banner visible until a genuinely fresh response arrives.
        await InvokeAsync(() =>
        {
            ApplyPing(pings);
            _pingFailed = ComputersV2Client.IsPingThrottled;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _cts.Cancel();
        _cts.Dispose();

        try
        {
            _ = JS.InvokeVoidAsync("cv2DisposeScrollTracking");
        }
        catch
        {
            // JS interop is unavailable during prerendering teardown; the listener simply stays inert.
        }

        _scrollRef?.Dispose();
    }
}