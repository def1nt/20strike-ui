@page "/"

@using _20strike_ui.Data
@inject IAuthenticationService Auth
@inject NavigationManager nm

<PageTitle>Index</PageTitle>

<h1>IT-ресурсы Вяземского Машиностроительного Завода.</h1>

<form @onsubmit="LoginAsync">
    <div class="container border p-3">
        <AuthorizeView Context="Account">
            <NotAuthorized>
                <b>Not hello</b>
                <div class="row my-3">
                    <div class="col-md">
                        <input @bind="username" @bind:event="oninput" class="form-control" placeholder="User name" />
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md">
                        <input type="password" @bind="password" @bind:event="oninput" class="form-control"
                               placeholder="Password" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md">
                        <input type="submit" class="btn btn-primary" value="Login">
                    </div>
                </div>
            </NotAuthorized>
            <Authorized>
                <b>Hello, @name</b>
                <div class="row">
                    <div class="col-md">
                        <input type="button" class="btn btn-primary" value="Logout" @onclick="LogoutAsync">
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</form>

@code {
    [Parameter]
    public string username { get; set; } = "";
    [Parameter]
    public string password { get; set; } = "";

    private string name = "";

    private async Task LoginAsync()
    {
        await Auth.LoginAsync(username, password);
        nm.NavigateTo("/", true); // Causes old circuit to be unexpectedly destroyed
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        nm.NavigateTo("/", true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        name = await Auth.GetCurrentUserNameAsync();
        StateHasChanged();
    }
}
